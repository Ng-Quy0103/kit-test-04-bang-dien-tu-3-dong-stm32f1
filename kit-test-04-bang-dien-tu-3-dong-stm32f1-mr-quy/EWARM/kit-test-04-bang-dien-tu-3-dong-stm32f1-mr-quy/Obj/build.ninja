#Generating source browse information for project kit-test-04-bang-dien-tu-3-dong-stm32f1-mr-quy


#Abbreviations
cc = E$:\IAR\common\bin\SourceIndexer.exe
ll = E$:\IAR\common\bin\PbdLink.exe
bd = E$:\IAR\common\bin\makeBrowseData.exe



#Rules
rule index
  depfile = $out.dep
  command = $cc -out=$out -f $in
rule link
  command = $ll -M $out $in
rule browsedata
  command = $bd $in -output  $out



#Build steps
build Indicator.pbi : index Indicator.xcl
build main.pbi : index main.xcl
build stm32f1xx_hal_msp.pbi : index stm32f1xx_hal_msp.xcl
build stm32f1xx_it.pbi : index stm32f1xx_it.xcl
build system_stm32f1xx.pbi : index system_stm32f1xx.xcl
build stm32f1xx_hal.pbi : index stm32f1xx_hal.xcl
build stm32f1xx_hal_cortex.pbi : index stm32f1xx_hal_cortex.xcl
build stm32f1xx_hal_dma.pbi : index stm32f1xx_hal_dma.xcl
build stm32f1xx_hal_exti.pbi : index stm32f1xx_hal_exti.xcl
build stm32f1xx_hal_flash.pbi : index stm32f1xx_hal_flash.xcl
build stm32f1xx_hal_flash_ex.pbi : index stm32f1xx_hal_flash_ex.xcl
build stm32f1xx_hal_gpio.pbi : index stm32f1xx_hal_gpio.xcl
build stm32f1xx_hal_gpio_ex.pbi : index stm32f1xx_hal_gpio_ex.xcl
build stm32f1xx_hal_pwr.pbi : index stm32f1xx_hal_pwr.xcl
build stm32f1xx_hal_rcc.pbi : index stm32f1xx_hal_rcc.xcl
build stm32f1xx_hal_rcc_ex.pbi : index stm32f1xx_hal_rcc_ex.xcl
build kit-test-04-bang-dien-tu-3-dong-stm32f1-mr-quy_part0.pbi : link Indicator.pbi main.pbi stm32f1xx_hal_msp.pbi stm32f1xx_it.pbi
build kit-test-04-bang-dien-tu-3-dong-stm32f1-mr-quy_part1.pbi : link system_stm32f1xx.pbi stm32f1xx_hal.pbi stm32f1xx_hal_cortex.pbi stm32f1xx_hal_dma.pbi
build kit-test-04-bang-dien-tu-3-dong-stm32f1-mr-quy_part2.pbi : link stm32f1xx_hal_exti.pbi stm32f1xx_hal_flash.pbi stm32f1xx_hal_flash_ex.pbi stm32f1xx_hal_gpio.pbi
build kit-test-04-bang-dien-tu-3-dong-stm32f1-mr-quy_part3.pbi : link stm32f1xx_hal_gpio_ex.pbi stm32f1xx_hal_pwr.pbi stm32f1xx_hal_rcc.pbi stm32f1xx_hal_rcc_ex.pbi
build kit-test-04-bang-dien-tu-3-dong-stm32f1-mr-quy.pbd : link kit-test-04-bang-dien-tu-3-dong-stm32f1-mr-quy_part0.pbi kit-test-04-bang-dien-tu-3-dong-stm32f1-mr-quy_part1.pbi kit-test-04-bang-dien-tu-3-dong-stm32f1-mr-quy_part2.pbi kit-test-04-bang-dien-tu-3-dong-stm32f1-mr-quy_part3.pbi
build kit-test-04-bang-dien-tu-3-dong-stm32f1-mr-quy.pbw : browsedata kit-test-04-bang-dien-tu-3-dong-stm32f1-mr-quy.pbd


